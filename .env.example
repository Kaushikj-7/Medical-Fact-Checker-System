# ==============================================================================
# Medical Corrective RAG (CRAG) - Environment Configuration
# ==============================================================================

# Primary LLM Provider: "gemini" or "openrouter" (default: "gemini", auto-fails over)
PRIMARY_PROVIDER=openrouter

# OpenRouter Configuration (Meta LLaMA 3.3 70B Instruct recommended)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Google Gemini Configuration
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash

# Storage & Retrieval Settings
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=medical_evidence
TOP_K=4
EVALUATOR_CONFIDENCE_THRESHOLD=0.65
REQUEST_TIMEOUT=15.0
